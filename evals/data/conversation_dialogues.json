  "dialogues": [
    {
      "id": "conv_001",
      "name": "Basic SEC Research",
      "description": "Straightforward financial questions",
      "turns": [
        {
          "role": "user",
          "content": "What was Apple's total revenue in fiscal year 2023?"
        },
        {
          "role": "user",
          "content": "How does that compare to 2022?"
        },
        {
          "role": "user",
          "content": "What about Microsoft's revenue in 2023?"
        }
      ],
      "rubric": {
        "task_completion": "Provide figures for all questions",
        "factual_accuracy": "Figures should match filings",
        "source_citation": "Must cite filing source",
        "coherence": "Must connect follow-up answers"
      },
      "expected_task_completion": true
    },
    {
      "id": "conv_002",
      "name": "Memory Persistence Test",
      "description": "Personal info then later recall",
      "turns": [
        {
          "role": "user",
          "content": "Hi my name is Sarah and I am a conservative investor focused on dividend stocks"
        },
        {
          "role": "user",
          "content": "What was JPMorgan's dividend per share in 2023?"
        },
        {
          "role": "user",
          "content": "Given my investment style what other companies should I look at?"
        },
        {
          "role": "user",
          "content": "What is my name and what kind of investor am I?"
        }
      ],
      "rubric": {
        "memory": "Remember name and profile",
        "personalization": "Recommendations should fit the profile",
        "task_completion": "Must answer the dividend question"
      },
      "expected_task_completion": true
    },
    {
      "id": "conv_003",
      "name": "Tool Chaining",
      "description": "RAG plus tools in same session",
      "turns": [
        {
          "role": "user",
          "content": "What was Tesla revenue in their 2023 annual report?"
        },
        {
          "role": "user",
          "content": "What is Tesla trading at right now?"
        },
        {
          "role": "user",
          "content": "If Tesla was at 150 when I bought it what is my ROI at the current price?"
        }
      ],
      "rubric": {
        "rag_use": "Use filings, not hallucination",
        "tool_use": "Must call stock_price",
        "tool_chaining": "Use current price in calculator",
        "coherence": "Stay coherent"
      },
      "expected_task_completion": true
    },
    {
