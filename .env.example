# LLM
LLM_MODEL_PATH=./models/Llama-3.2-3B-Instruct-Q4_K_M.gguf
N_THREADS=8
N_CTX=4096

# Paths
CHROMA_PATH=./chroma_db
DATA_PATH=./data
DOCUMENTS_PATH=./documents

# Voice
WHISPER_MODEL=base.en
TTS_VOICE=en-US-AriaNeural
TTS_BACKEND=auto

# RAG
TOP_K_CHUNKS=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Session
SESSION_TIMEOUT_MINUTES=30
MAX_SESSIONS=50

# Logging
LOG_LEVEL=INFO
